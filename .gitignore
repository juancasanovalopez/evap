# Allow-list the repository content we intentionally track: backend code,
# Terraform for AWS deployment, and the GitHub Actions workflow.
/*
!/backend
!/backend/**
!/infra
!/infra/**
!/.github
!/.github/**
!/README.md
!/.gitignore

# Re-ignore generated and sensitive artifacts after the allow-list above.
backend/dist/
backend/*.test
backend/.env
backend/.env.*
!backend/.env.example
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/terraform.tfvars
infra/*.tfplan
*.out
*.mod.bak
