# Copy to .env (or export manually) for local development. Never commit real values.
DYNAMODB_TABLE_NAME=evap_users_local
OAUTH_REDIRECT_BASE_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Use a strong random value locally too; never reuse the "dev-secret" example from the README in production.
JWT_SIGNING_KEY=
LOCAL_HTTP_ADDR=:8080
# Leave unset locally; set in production to load OAuth/JWT secrets from AWS SSM Parameter Store instead.
OAUTH_SSM_PREFIX=
